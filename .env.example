# Server Configuration
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wallet_voice_call

# Authentication & Session Security
# Generate a 32-byte secret with: openssl rand -hex 32
SESSION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SESSION_TTL_HOURS=72
AUTH_NONCE_TTL_SECONDS=300
AUTH_DOMAIN=localhost:3001

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional WebRTC STUN / TURN Relays
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN_URLS=turn:your-turn-host:3478
# TURN_USERNAME=turnuser
# TURN_CREDENTIAL=turnsecret
DISCONNECT_GRACE_PERIOD_SECONDS=20
