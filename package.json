{
  "name": "wallet-voice-call",
  "version": "1.0.0",
  "description": "Wallet-to-wallet encrypted WebRTC voice calling using EVM SIWE auth, Fastify WebSocket signaling, Drizzle PostgreSQL, and React 19.",
  "license": "MIT",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "tsc && vite build --config client/vite.config.ts",
    "build:client": "vite build --config client/vite.config.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p client/tsconfig.json --noEmit",
    "db:generate": "tsc && drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.0",
    "@fastify/websocket": "^11.0.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "fastify": "^5.2.1",
    "fastify-type-provider-zod": "^4.0.2",
    "lucide-react": "^1.55.0",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "^2.57.4",
    "ws": "^8.22.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.5"
  },
  "overrides": {
    "cookie": "^1.0.2"
  }
}
